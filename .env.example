# Fib SMA bot (matches fib_sma.pine) — local development env vars
# Copy this to .env and fill in your values

# Required
DATABASE_URL=postgresql://user:password@host/dbname

# CORS (comma-separated origins)
CORS_ORIGINS=https://apex-firm.vercel.app,http://localhost:3000

# Timeframes (Pine: chart 15m, HTF 4H)
TIMEFRAME=15m
HTF_TIMEFRAME=4h
BAR_MINUTES=15
HTF_MINUTES=240

# Fib + SMA (match fib_sma.pine inputs)
FIB_LEVEL=0.618
FIB_LENGTH=50
SMA_FAST=50
SMA_SLOW=200

# How many closed 15m bars to scan for missed marks (~7 days)
LOOKBACK_BARS=672

# Scanner timing
SCAN_INTERVAL_S=60
SYMBOL_SLEEP_S=0.35
CACHE_TTL_S=55

# Set to "true" for a single scan then exit (useful for testing)
BOT_RUN_ONCE=false
