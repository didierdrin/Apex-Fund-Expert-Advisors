# SR Break + Stationarity bot — local development env vars
# Copy this to .env and fill in your values

# Required
DATABASE_URL=postgresql://user:password@host/dbname

# CORS (comma-separated origins)
CORS_ORIGINS=https://apex-firm.vercel.app,http://localhost:3000

# Timeframes
TIMEFRAME=1m
HTF_TIMEFRAME=15m
HTF_MINUTES=15

# Signal filters (tuned for 1m bars)
MIN_SMA_DIST_TICKS=50
MAX_SMA_SLOPE_PCT=1.0
ZSCORE_THRESH=1.5
LOOKBACK=50
LEFT_BARS=15
RIGHT_BARS=15
TREND_MA_PERIOD=20

# Scanner timing
SCAN_INTERVAL_S=120
SYMBOL_SLEEP_S=0.35
CACHE_TTL_S=55

# Set to "true" for a single scan then exit (useful for testing)
BOT_RUN_ONCE=false
