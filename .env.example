# Fib SMA bot (matches fib_sma.pine) — local development env vars
# Copy this to .env and fill in your values

# Required
DATABASE_URL=postgresql://user:password@host/dbname

# CORS (comma-separated origins)
CORS_ORIGINS=https://apex-firm.vercel.app,http://localhost:3000

# Timeframes (Pine: chart adapts to viewed TF, HTF fixed 4H)
# TIMEFRAME=1m for fast verification (frequent marks); switch to 15m for
# production-pace signals. BAR_MINUTES/HTF_MINUTES auto-derive from
# TIMEFRAME/HTF_TIMEFRAME if left unset — only override if you need them
# to diverge from the parsed value.
TIMEFRAME=1m
HTF_TIMEFRAME=4h

# Fib + SMA (match fib_sma.pine inputs)
FIB_LEVEL=0.618
FIB_LENGTH=50
SMA_FAST=50
SMA_SLOW=200

# How many closed bars to scan for missed marks (~33h at 1m, ~3 weeks at 15m)
LOOKBACK_BARS=2000

# Scanner timing
SCAN_INTERVAL_S=60
SYMBOL_SLEEP_S=0.35
CACHE_TTL_S=55

# Set to "true" for a single scan then exit (useful for testing)
BOT_RUN_ONCE=false
